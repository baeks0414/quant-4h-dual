# copy to /etc/quant4h.env, chmod 600, owned by root
# API key: enable FUTURES TRADING ONLY. Disable withdrawals. Whitelist this VPS IP.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# start in dry run. Flip to 0 only after a few clean dry runs.
DRY_RUN=1

# CEILING on the capital the strategy sizes against, USD. Sizing follows the
# futures wallet and never exceeds it, so this only caps growth. Leave unset
# to always size against the full wallet balance.
REAL_CAPITAL=700

# halt trading permanently once equity falls 35% below the recorded baseline
KILL_DRAWDOWN=0.35

# Order caps. By default these scale with the capital in use: a single order may
# be up to 2x capital (a full reversal is 2x), and the whole book up to 3x.
#
# Do NOT set a fixed dollar cap below your capital. This strategy holds up to
# about 100% of capital in one leg, so MAX_ORDER_USD=300 on a 700 USD account
# refuses every entry, silently, forever.
#MAX_ORDER_MULT=2.0
#MAX_GROSS_MULT=3.0

# rest as a maker this long before taking the remainder at market
LIMIT_WAIT_SEC=90

# skip a trade rather than inflate it by more than this when rounding to a lot
MAX_ROUND_UP=0.25

TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
